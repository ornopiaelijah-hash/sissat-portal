rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isFaculty() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'faculty') ||
        (request.auth.token.email != null && request.auth.token.email.lower().endsWith('@faculty.southdale.edu.ph'))
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'elijahmiguel012207@gmail.com' ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Profiles ---
    match /profiles/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isFaculty() || isAdmin());
      allow list: if isAdmin() || isFaculty();
      
      allow create: if isSignedIn() && isOwner(userId) && isValidProfile(incoming());
      allow update: if isSignedIn() && (
        (isOwner(userId) && isValidProfile(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['firstName', 'lastName', 'fullName', 'phone', 'language', 'avatar'])) ||
        isAdmin() || isFaculty()
      );
    }

    function isValidProfile(data) {
      return (!('firstName' in data) || (data.firstName is string && data.firstName.size() <= 100)) &&
             (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 100)) &&
             (!('role' in data) || (data.role in ['student', 'faculty', 'admin'])) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 20)) &&
             (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 50));
    }

    // --- Grades ---
    match /grades/{gradeId} {
      allow read, write: if true;
    }

    function isValidGrade(data) {
      return (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 128)) &&
             (!('module' in data) || (data.module is string && data.module.size() <= 200)) &&
             (!('code' in data) || (data.code is string && data.code.size() <= 50)) &&
             (!('grade' in data) || (data.grade is string && data.grade.size() <= 10)) &&
             (!('instructor' in data) || (data.instructor is string && data.instructor.size() <= 200)) &&
             (!('assessment' in data) || (data.assessment is string && data.assessment.size() <= 200)) &&
             (!('credits' in data) || (data.credits is number || (data.credits is string && data.credits.size() <= 10))) &&
             (!('q1' in data) || (data.q1 is string && data.q1.size() <= 10)) &&
             (!('q2' in data) || (data.q2 is string && data.q2.size() <= 10)) &&
             (!('q3' in data) || (data.q3 is string && data.q3.size() <= 10)) &&
             (!('q4' in data) || (data.q4 is string && data.q4.size() <= 10)) &&
             (!('average' in data) || (data.average is string && data.average.size() <= 10));
    }
  }
}
